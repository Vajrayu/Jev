#!/usr/bin/env python3
"""Summarise ~/.jev-gateway/decisions.jsonl. Usage: jevstats [hours]   (default: everything)"""
import collections, json, os, sys, time

path = os.path.expanduser("~/.jev-gateway/decisions.jsonl")
hours = float(sys.argv[1]) if len(sys.argv) > 1 else None
rows = []
try:
    for line in open(path):
        try:
            rows.append(json.loads(line))
        except ValueError:
            pass
except OSError:
    sys.exit("No decisions logged yet (" + path + ").")
if hours:
    cutoff = time.time() - hours * 3600
    rows = [r for r in rows if r["ts"] >= cutoff]

routes = [r for r in rows if r.get("event") == "route"]
fallbacks = [r for r in rows if r.get("event") == "fallback"]
applied = [r for r in routes if r.get("applied")]
tiers = collections.Counter(r.get("tier") for r in applied)
failed = [r for r in routes if "jev failed" in (r.get("reason") or "")]
bumped = [r for r in routes if "too long" in (r.get("reason") or "")]
moved_off_asked = [r for r in applied if r.get("chosen") != r.get("asked")]
jev_cost = sum(r.get("jev_cost") or 0 for r in routes if not r.get("cached"))
jev_calls = sum(1 for r in routes if not r.get("cached") and r.get("jev_cost"))
ms = [r["jev_ms"] for r in routes if r.get("jev_ms") and not r.get("cached")]

print("Window            :", ("last %g hours" % hours) if hours else "all logged decisions")
print("Routed requests   :", len(routes), "(%d applied, %d shadow only)" % (len(applied), len(routes) - len(applied)))
for t in ("haiku", "sonnet", "opus"):
    print("  %-7s         : %d" % (t, tiers.get(t, 0)))
print("Moved off the model Claude Code asked for:", len(moved_off_asked), "requests")
print("Bumped up (conversation too long for haiku):", len(bumped))
print("Rejected + retried (fallback)             :", len(fallbacks))
print("Jev failures (fell back to sonnet)        :", len(failed))
print("Jev calls         : %d, total cost $%.4f, median %d ms" % (jev_calls, jev_cost, sorted(ms)[len(ms) // 2] if ms else 0))
print()
print("Savings are NOT calculated: the log has conversation sizes (est_tokens) but not")
print("real token usage or your model prices. Each request moved off Opus to Haiku or")
print("Sonnet is a request that cost less than it would have; Jev's own cost is above.")
